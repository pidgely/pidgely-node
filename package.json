{
  "name": "pidgely",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript SDK for the Pidgely email API (Resend-compatible).",
  "keywords": [
    "pidgely",
    "email",
    "email-api",
    "transactional-email",
    "resend",
    "sdk",
    "smtp",
    "webhooks"
  ],
  "homepage": "https://docs.pidgely.com",
  "bugs": "https://github.com/pidgely/pidgely-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgely/pidgely-node.git"
  },
  "license": "MIT",
  "author": "Caotec Serviços em Tecnologia Ltda <dev@fexxo.com.br>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "openapi-typescript openapi/pidgely.yaml -o src/generated/openapi.ts",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "test:dist": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^18.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
